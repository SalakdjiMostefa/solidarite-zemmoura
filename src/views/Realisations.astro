---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnteteePage from '../components/EnteteePage.astro';
import Accomplissements from '../islands/Accomplissements';
import ChiffresCles from '../islands/ChiffresCles';
import BoutiqueApercu from '../islands/BoutiqueApercu';
import { tr, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = tr(lang).realisations;
---

<BaseLayout title={t.titre} description={t.description} lang={lang}>
  <EnteteePage surtitre={t.surtitre} titre={t.titre} sousTitre={lang === 'fr' ? 'إنجازاتنا' : undefined} intro={t.intro} />
  <section class="conteneur py-10">
    <ChiffresCles client:visible lang={lang} />
  </section>
  <section class="conteneur max-w-4xl pb-16">
    <h2 class="titre-section">{t.accompli}</h2>
    <p class="lead mt-3 mb-10 max-w-2xl">{t.accompliIntro}</p>
    <Accomplissements client:visible lang={lang} />
    <div class="mt-16">
      <BoutiqueApercu client:load lang={lang} variante="bandeau" />
    </div>
  </section>
</BaseLayout>
