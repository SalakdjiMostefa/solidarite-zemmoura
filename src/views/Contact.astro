---
/** Contact : WhatsApp, téléphones, email, Facebook, YouTube, carte simple des deux villes */
import BaseLayout from '../layouts/BaseLayout.astro';
import EnteteePage from '../components/EnteteePage.astro';
import { DEFAULT_CONTACT, formatTel } from '../config/site';
import { tr, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const T = tr(lang);
const t = T.contact;
const c = DEFAULT_CONTACT;
const canaux = [
  { cle: 'whatsapp', label: t.whatsapp, valeur: formatTel(c.whatsapp.replace(/^33/, '+33')), href: `https://wa.me/${c.whatsapp}`, icone: '💬', ltr: true },
  { cle: 'phone', label: t.tel, valeur: formatTel(c.phone), href: `tel:${c.phone}`, icone: '📞', ltr: true },
  ...(c.phone2 ? [{ cle: 'phone2', label: t.tel2, valeur: formatTel(c.phone2), href: `tel:${c.phone2}`, icone: '📞', ltr: true }] : []),
  { cle: 'email', label: t.email, valeur: c.email, href: `mailto:${c.email}`, icone: '✉️', ltr: true },
  { cle: 'facebook', label: t.facebook, valeur: t.suivre, href: c.facebook, icone: '👍', ltr: false },
  { cle: 'tiktok', label: 'TikTok', valeur: c.tiktok.includes('@') ? '@' + c.tiktok.split('@')[1].split('/')[0] : 'TikTok', href: c.tiktok, icone: '🎵', ltr: true },
  { cle: 'youtube', label: 'YouTube', valeur: lang === 'ar' ? 'شاهدوا الفيديو' : 'Voir la vidéo', href: c.youtube, icone: '▶️', ltr: false },
];
---

<BaseLayout title={t.titre} description={t.description} lang={lang}>
  <EnteteePage surtitre={t.surtitre} titre={t.titre} sousTitre={lang === 'fr' ? 'اتصل بنا' : undefined} />
  <section class="conteneur grid grid-cols-1 gap-8 py-10 lg:grid-cols-2">
    <ul class="grid min-w-0 grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-1">
      {
        canaux.map((k) => (
          <li>
            <a
              href={k.href}
              data-contact={k.cle}
              class="carte carte-survol flex min-h-16 items-center gap-4 p-4"
              target={k.href.startsWith('http') ? '_blank' : undefined}
              rel="noopener"
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-pierre text-xl" aria-hidden="true">
                {k.icone}
              </span>
              <span class="min-w-0">
                <span class="block font-semibold">{k.label}</span>
                <span class="block truncate text-encre/75" dir={k.ltr ? 'ltr' : undefined} style={k.ltr ? 'text-align:start' : undefined}>
                  {k.valeur}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <figure class="carte overflow-hidden p-4">
      <svg viewBox="0 0 400 300" class="w-full" role="img" aria-labelledby="carte-titre">
        <title id="carte-titre">{t.carte}</title>
        <rect width="400" height="300" rx="16" fill="#F3EEE6"></rect>
        <path d="M60 30 L120 20 L160 50 L170 110 L140 150 L80 145 L50 110 L40 60 Z" fill="#FFFFFF" stroke="#1F1B18" stroke-opacity="0.25"></path>
        <path d="M200 170 L300 160 L370 180 L380 280 L230 285 L190 230 Z" fill="#FFFFFF" stroke="#1F1B18" stroke-opacity="0.25"></path>
        <path d="M130 110 C190 110 230 150 268 190" fill="none" stroke="#D9622B" stroke-width="1.6" stroke-dasharray="5 5"></path>
        <circle cx="130" cy="110" r="5" fill="#1F1B18"></circle>
        <circle cx="268" cy="190" r="5" fill="#D9622B"></circle>
        <text x="122" y="130" text-anchor="end" font-size="13" fill="#1F1B18">{T.pont.stChamond}</text>
        <text x="278" y="212" font-size="13" fill="#1F1B18">{T.pont.zemmoura}</text>
        <text x="200" y="140" text-anchor="middle" font-size="11" font-style="italic" fill="#1D4E89">{T.pont.mer}</text>
        <text x="100" y="80" text-anchor="middle" font-size="11" fill="#1F1B18" fill-opacity="0.5">{t.france}</text>
        <text x="300" y="250" text-anchor="middle" font-size="11" fill="#1F1B18" fill-opacity="0.5">{t.algerie}</text>
      </svg>
      <figcaption class="mt-3 text-sm text-encre/70">{t.legende}</figcaption>
    </figure>
  </section>
</BaseLayout>
