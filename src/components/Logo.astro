---
/** Logo officiel (rond) + nom de l'association (nom principal dans la langue de la page) */
import type { Lang } from '../i18n';
interface Props {
  clair?: boolean;
  compact?: boolean;
  lang?: Lang;
}
const { clair = false, compact = false, lang = 'fr' } = Astro.props;
const principal = lang === 'ar' ? 'تضامن زمورة' : 'Solidarité Zemmoura';
const second = lang === 'ar' ? 'Solidarité Zemmoura' : 'تضامن زمورة';
---

<span class="inline-flex items-center gap-2 sm:gap-2.5">
  <img src="/images/logo.png" width="40" height="40" alt="" class="h-9 w-9 shrink-0 sm:h-10 sm:w-10" decoding="async" />
  {
    !compact && (
      <span class="flex flex-col gap-0.5 whitespace-nowrap leading-none">
        <span class={`font-titre text-[0.95rem] font-medium sm:text-[1.1rem] ${clair ? 'text-white' : 'text-encre'}`}>{principal}</span>
        <span lang={lang === 'ar' ? 'fr' : 'ar'} class={`text-[0.75rem] ${clair ? 'text-white/70' : 'text-encre/55'}`}>
          {second}
        </span>
      </span>
    )
  }
</span>
