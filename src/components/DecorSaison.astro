---
/**
 * Décors saisonniers discrets (affichés selon html[data-season]) :
 * Ramadan → croissant ; Aïd → étoile ; fin d'année → petite guirlande de points.
 */
---

<div class="pointer-events-none absolute end-5 top-5 z-0 sm:end-10 sm:top-8" aria-hidden="true">
  <svg class="deco-saison deco-ramadan h-12 w-12 sm:h-16 sm:w-16" viewBox="0 0 40 40">
    <path d="M24 4 A16 16 0 1 0 36 28 A13 13 0 1 1 24 4 Z" fill="#F4A300"></path>
  </svg>
  <svg class="deco-saison deco-aid h-12 w-12 sm:h-16 sm:w-16" viewBox="0 0 40 40">
    <path d="M20 4 L23.5 15 L35 15 L25.8 22 L29.4 33 L20 26.4 L10.6 33 L14.2 22 L5 15 L16.5 15 Z" fill="none" stroke="#F4A300" stroke-width="1.5"></path>
  </svg>
  <svg class="deco-saison deco-fin-annee h-6 w-32" viewBox="0 0 130 24">
    <path d="M2 4 Q65 30 128 4" fill="none" stroke="#1F1B18" stroke-opacity="0.3"></path>
    {[18, 42, 65, 88, 112].map((x, i) => <circle cx={x} cy={i === 2 ? 17 : i % 4 === 0 ? 9 : 14} r="3" fill={['#A51D2B', '#F4A300', '#0B8F4D'][i % 3]} />)}
  </svg>
</div>
