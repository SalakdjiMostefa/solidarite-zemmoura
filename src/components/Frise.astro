---
/**
 * Frise géométrique minimale : une ligne de petits losanges au trait fin.
 * Séparateur discret, à utiliser avec parcimonie.
 */
interface Props {
  clair?: boolean;
  class?: string;
}
const { clair = false, class: className = '' } = Astro.props;
const id = `frise-${Math.random().toString(36).slice(2, 8)}`;
const couleur = clair ? '#FBF8F3' : '#9C4319';
---

<svg class={`block h-3 w-full ${className}`} aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <pattern id={id} width="24" height="12" patternUnits="userSpaceOnUse">
      <path d="M12 2 L16 6 L12 10 L8 6 Z" fill="none" stroke={couleur} stroke-width="1"></path>
      <path d="M0 6 H6 M18 6 H24" stroke={couleur} stroke-width="1"></path>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} opacity="0.45"></rect>
</svg>
