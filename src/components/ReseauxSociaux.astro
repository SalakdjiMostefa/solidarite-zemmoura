---
/** Bloc « Suivez-nous » : Facebook, TikTok, YouTube, WhatsApp (icônes SVG simples, sans script tiers) */
import { DEFAULT_CONTACT } from '../config/site';
import { tr, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = tr(lang).reseaux;
const c = DEFAULT_CONTACT;
const pseudoTiktok = c.tiktok.includes('@') ? '@' + c.tiktok.split('@')[1].split('/')[0] : 'TikTok';

const reseaux = [
  {
    nom: 'Facebook',
    detail: t.facebook,
    href: c.facebook,
    couleur: '#1877F2',
    icone: 'M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v9h4v-9h3l.5-4h-3.5V9c0-.6.4-1 1-1Z',
  },
  {
    nom: 'TikTok',
    detail: pseudoTiktok,
    href: c.tiktok,
    couleur: '#1F1B18',
    icone: 'M16.5 3c.4 2.3 1.9 3.9 4.2 4.2v3.4c-1.5 0-3-.5-4.2-1.3v6.3c0 3.5-2.7 6.1-6.1 6.1S4.3 19 4.3 15.6s2.8-6.1 6.4-6v3.5c-1.5-.2-2.9.9-2.9 2.5 0 1.4 1.1 2.6 2.6 2.6s2.6-1.1 2.6-2.8V3h3.5Z',
  },
  {
    nom: 'YouTube',
    detail: t.youtube,
    href: c.youtube,
    couleur: '#E62117',
    icone: 'M22 8.2c-.2-1.6-1-2.7-2.6-2.9C16.9 5 12 5 12 5s-4.9 0-7.4.3C3 5.5 2.2 6.6 2 8.2 1.8 9.4 1.8 12 1.8 12s0 2.6.2 3.8c.2 1.6 1 2.7 2.6 2.9 2.5.3 7.4.3 7.4.3s4.9 0 7.4-.3c1.6-.2 2.4-1.3 2.6-2.9.2-1.2.2-3.8.2-3.8s0-2.6-.2-3.8ZM10 15.2V8.8l5.5 3.2-5.5 3.2Z',
  },
  {
    nom: 'WhatsApp',
    detail: t.whatsapp,
    href: `https://wa.me/${c.whatsapp}`,
    couleur: '#157A40',
    icone: 'M12 2.2A9.7 9.7 0 0 0 3.6 16.8L2.3 21.7l5-1.3A9.7 9.7 0 1 0 12 2.2Zm0 17.7c-1.5 0-2.9-.4-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 19.9Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1c0 1.2.9 2.4 1 2.6.1.2 1.8 2.7 4.3 3.8 1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z',
  },
];
---

<section class="conteneur py-16 sm:py-20" aria-labelledby="t-reseaux">
  <div class="mb-8 text-center">
    <p class="surtitre surtitre-centre">{t.surtitre}</p>
    <h2 id="t-reseaux" class="titre-section">{t.titre}</h2>
    <p class="lead mx-auto mt-3 max-w-xl">{t.texte}</p>
  </div>
  <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    {
      reseaux.map((r) => (
        <li>
          <a
            href={r.href}
            target="_blank"
            rel="noopener"
            class="carte carte-survol flex h-full flex-col items-center gap-3 px-3 py-6 text-center"
            aria-label={`${r.nom} — ${r.detail}`}
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-full" style={`background:${r.couleur}`} aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="#fff">
                <path d={r.icone} />
              </svg>
            </span>
            <span class="font-semibold">{r.nom}</span>
            <span class="max-w-full break-all text-[13px] leading-snug text-encre/60 sm:text-sm" dir={r.nom === 'TikTok' ? 'ltr' : undefined}>
              {r.detail}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
