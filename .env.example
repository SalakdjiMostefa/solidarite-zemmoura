# ─── Site ───────────────────────────────────────────────
PUBLIC_SITE_URL=https://solidarite-zemoura.web.app

# ─── Firebase (Console Firebase > Paramètres du projet > Vos applications) ───
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=votre-projet
PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# ─── Cloudinary (upload preset NON signé) ──────────────
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ─── Valeurs par défaut (écrasées par Firestore settings/*) ───
PUBLIC_BANK_HOLDER=Association Solidarité Zemmoura
PUBLIC_BANK_IBAN=FR76 0000 0000 0000 0000 0000 000
PUBLIC_BANK_BIC=XXXXFRPPXXX
PUBLIC_HELLOASSO_URL=https://www.helloasso.com/associations/solidarite-zemmoura
PUBLIC_CONTACT_EMAIL=contact@solidarite-zemoura.fr
PUBLIC_CONTACT_PHONE=+33600000000
PUBLIC_CONTACT_PHONE2=
PUBLIC_CONTACT_WHATSAPP=33600000000
PUBLIC_CONTACT_FACEBOOK=https://www.facebook.com/
PUBLIC_CONTACT_YOUTUBE=https://www.youtube.com/
PUBLIC_CONTACT_TIKTOK=https://www.tiktok.com/

# ─── Script de seed uniquement (NE JAMAIS committer la clé) ───
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
